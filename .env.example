# Shared OpenAI-compatible backend configuration used by frontier lanes.
# Use one provider block at a time.

# OpenAI example
FRONTIER_API_KEY=replace-me
FRONTIER_MODEL=gpt-4o-mini
FRONTIER_API_BASE_URL=https://api.openai.com/v1

# Lambda Cloud (for training) example
FRONTIER_API_KEY=replace-me
FRONTIER_API_BASE_URL=https://api.lambda.ai/v1

# Lambda Cloud instance-control API for cloud eval launchers.
# Requires a Lambda Cloud key with instance permissions.
LAMBDA_API_KEY=replace-me
LAMBDA_API_BASE=https://cloud.lambda.ai/api/v1
